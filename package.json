    "serve": "node server.js"
  },
  "dependencies": {
    "@types/express": "^5.0.0",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "nodemon": "^3.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  }
}
