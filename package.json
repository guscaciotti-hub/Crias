{
  "name": "crias-game",
  "version": "1.0.0",
  "description": "CRIAS — Monster Tamer Online",
  "type": "module",
  "scripts": {
    "start": "node --loader ts-node/esm --experimental-specifier-resolution=node src/index.ts",
