{
  "name": "atendeai",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "workspaces": [
    "server",
    "client",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"pnpm --filter server dev\" \"pnpm --filter client dev\"",
    "build": "pnpm --filter client build && cd server && node_modules/.bin/tsc",
    "start": "node server/dist/server/index.js",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "drizzle-orm": "^0.41.0"
  }
}
