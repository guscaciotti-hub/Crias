{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "shared/*": ["../shared/*"],
      "drizzle/*": ["../drizzle/*"]
    }
  },
  "include": ["./**/*.ts", "../drizzle/**/*.ts", "../shared/**/*.ts"]
}
